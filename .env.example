# Copy is generated by scripts/init-env.sh (do not copy by hand: it fills in random secrets).
# Only this example is committed; .env is git-ignored.
POSTGRES_PASSWORD=change-me
SUPPORT_DB_PASSWORD=change-me
BILLING_DB_PASSWORD=change-me

# Host-side URLs (tests, local runs). Services inside compose use host "db" instead of localhost.
SUPPORT_DATABASE_URL=postgresql+psycopg://support_app:change-me@localhost:5432/uas
BILLING_DATABASE_URL=postgresql+psycopg://billing_app:change-me@localhost:5432/uas
SUPPORT_TEST_DATABASE_URL=postgresql+psycopg://support_app:change-me@localhost:5432/uas_test
BILLING_TEST_DATABASE_URL=postgresql+psycopg://billing_app:change-me@localhost:5432/uas_test

BILLING_API_KEY=change-me
FAULT_ADMIN_KEY=change-me
IDENTIFIER_HASH_KEY=change-me

# Exact origins, comma-separated, no trailing slash.
# Local: http://localhost:5173
# Codespaces: https://${CODESPACE_NAME}-5173.${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN}
ALLOWED_ORIGINS=http://localhost:5173

LLM_PROVIDER=scripted
LIVE_LLM_ENABLED=false
OPENAI_API_KEY=
